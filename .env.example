# Copy to .env for local use (git-ignored) or inject through your host's secret mechanism
# (systemd EnvironmentFile, Docker/Kubernetes secrets, a secrets manager). Never commit real values.
# Nothing in aoa loads this file itself: export it, or pass it with `docker run --env-file`,
# systemd EnvironmentFile=, or `set -a; . ./.env; set +a`.

# --- required ---
ANTHROPIC_API_KEY=
# Bearer token for /sessions/* endpoints (send the same value from clients as AOA_API_TOKEN).
AOA_API_TOKEN=
# Shared secret for /webhooks/* (callers send it as the X-AOA-Secret header).
AOA_WEBHOOK_SECRET=

# --- local development only: allow the server to start without the two secrets above ---
# AOA_ALLOW_INSECURE=1

# --- optional (defaults shown) ---
# AOA_DATA_DIR=./data                 # SQLite file, memory, sandbox; use an absolute path on a persistent volume
# AOA_TEMPORAL_ADDRESS=localhost:7233
# AOA_TEMPORAL_NAMESPACE=default
# AOA_TASK_QUEUE=aoa
# AOA_MODEL=claude-sonnet-5-5
# AOA_HELPER_MODEL=claude-sonnet-5-5
# AOA_REVIEW_MODEL=claude-haiku-5-5
# AOA_TZ=America/New_York
# AOA_SERVER=http://127.0.0.1:8000    # used by client_cli

# --- Slack bridge (python -m aoa.slack_bridge; see docs/slack-setup.md) ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_CHANNEL_ID=C0123456789          # the private channel the agent lives in
# SLACK_ALLOWED_USER_ID=U0123456789     # the only Slack user trusted to talk to the agent
# AOA_SESSION=main
