+def test_diff_index_lists_the_new_side_ranges():
+    idx = diff_index(DIFF)
+    assert idx["app/auth.py"] == [(10, 13), (41, 41)]
+    assert idx["old.py"] == []  # deleted: nothing on the new side
+    assert idx["dir/new file.txt"] == [(1, 2)] and "not-a-header" not in idx
