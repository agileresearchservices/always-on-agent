# Copy to .env for local use (git-ignored) or inject through your host's secret mechanism
# (systemd EnvironmentFile, Docker/Kubernetes secrets, a secrets manager). Never commit real values.
# Nothing in aoa loads this file itself: export it, or pass it with `docker run --env-file`,
# systemd EnvironmentFile=, or `set -a; . ./.env; set +a`.

# --- required ---
ANTHROPIC_API_KEY=
# Bearer token for /sessions/* endpoints (send the same value from clients as AOA_API_TOKEN).
AOA_API_TOKEN=
# Shared secret for /webhooks/* (callers send it as the X-AOA-Secret header).
AOA_WEBHOOK_SECRET=

# --- local development only: allow the server to start without the two secrets above ---
# AOA_ALLOW_INSECURE=1

# --- optional (defaults shown) ---
# AOA_DATA_DIR=./data                 # SQLite file, memory, sandbox; use an absolute path on a persistent volume
# AOA_TEMPORAL_ADDRESS=localhost:7233
# AOA_TEMPORAL_NAMESPACE=default
# AOA_TASK_QUEUE=aoa
# AOA_MODEL=claude-sonnet-5-5
# AOA_HELPER_MODEL=claude-sonnet-5-5
# AOA_REVIEW_MODEL=claude-haiku-5-5
# AOA_TZ=America/New_York
# AOA_SERVER=http://127.0.0.1:8000    # used by client_cli

# --- Slack bridge (python -m aoa.slack_bridge; see docs/slack-setup.md) ---
# App-level token (starts xapp-, scope connections:write) enables Socket Mode.
# SLACK_APP_TOKEN=xapp-...
# Bot User OAuth Token (starts xoxb-), from Install App after the app is installed to the workspace.
# SLACK_BOT_TOKEN=xoxb-...
# The private channel the agent lives in (starts C or G) and the only Slack user trusted to talk to it (starts U).
# SLACK_CHANNEL_ID=C0123456789
# SLACK_ALLOWED_USER_ID=U0123456789
# AOA_SESSION=main

# --- GitHub PR-review monitor (worker polls; no model call unless a new PR appears) ---
# Fine-grained PAT, read-only: repository access = your repos, permissions = Pull requests (read) + Metadata (read).
# GITHUB_TOKEN=github_pat_...
# AOA_GITHUB_USER=agileresearchservices
# AOA_GITHUB_POLL_SECONDS=600
# Reviewer identity (#11), so PR reviews can APPROVE / REQUEST_CHANGES instead of commenting. Off when unset.
# A GitHub App (pip install -e '.[github-app]'): no webhook; repository permissions Pull requests: read & write,
# Metadata: read; installed on your account's repos. Key file mode 600, outside this repo and the data dir.
# AOA_REVIEWER_APP_ID=123456
# AOA_REVIEWER_APP_KEY_FILE=~/.config/aoa/reviewer-app.pem
# Or a second account's token instead of an App:
# AOA_REVIEWER_TOKEN=github_pat_...
# Test command run after aoa resolves a PR's merge conflicts (before it pushes), per repo; "" = none.
# Otherwise the base branch's .aoa/test-command is used, else pytest in a fresh venv for Python repos with tests.
# AOA_TEST_COMMANDS={"agileresearchservices/some-repo": "make test"}

# Approvals: nudge once after this many seconds, expire after the second (defaults 4h / 24h)
# AOA_APPROVAL_NUDGE=14400
# AOA_APPROVAL_EXPIRE=86400

# Prompt-cache lifetime in seconds: 300 (default, 5 minutes) or 3600 (1 hour); anything above 300 means 1 hour.
# 1h writes cost 2x base input instead of 1.25x, so it only pays when calls are mostly 5-60 minutes apart.
# Measured on this agent's own usage (97.6% of model calls follow another within 5 minutes): 1h costs ~16% more.
# AOA_CACHE_TTL=3600
